generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Flint · Cloud Sandbox & Agent Orchestration Platform
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("admin") // admin | member | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String
  scopes      String    @default("sandbox:read,sandbox:write,agent:run")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Template {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  category    String     // runtime | desktop | data | browser | custom
  icon        String     @default("box")
  baseImage   String
  packages    String     @default("")
  tags        String     @default("")
  bootSeconds Int        @default(3)
  sizeMb      Int        @default(420)
  isOfficial  Boolean    @default(true)
  launches    Int        @default(0)
  sandboxes   Sandbox[]
}

model Sandbox {
  id               String     @id @default(cuid())
  name             String
  status           String     @default("provisioning")
  // provisioning | running | stopped | hibernated | error | destroying
  driver           String     @default("local") // local | cloud-vm
  region           String     @default("us-east-1")
  templateId       String?
  template         Template?  @relation(fields: [templateId], references: [id])
  vcpu             Int        @default(2)
  memoryGb         Int        @default(4)
  diskGb           Int        @default(20)
  workspacePath    String?
  sshPort          Int?
  parentId         String? // fork lineage
  hibernateAfterMin Int      @default(15)
  autoDeleteAt     DateTime?
  lastActiveAt     DateTime   @default(now())
  startedAt        DateTime?
  stoppedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  snapshots        Snapshot[]
  tasks            AgentTask[]
  usageEvents      UsageEvent[]
  sessions         AgentSession[]

  @@index([status])
  @@index([createdAt])
}

model Snapshot {
  id         String   @id @default(cuid())
  sandboxId  String
  sandbox    Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  name       String
  sizeMb     Int      @default(0)
  isTemplate Boolean  @default(false)
  forkCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sandboxId])
}

model AgentTask {
  id            String      @id @default(cuid())
  name          String
  prompt        String
  sandboxId     String?
  sandbox       Sandbox?     @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  model         String      @default("glm-4.7")
  status        String      @default("queued") // queued | planning | running | done | failed | cancelled
  maxSteps      Int         @default(12)
  toolConcurrency Int       @default(4)
  strategy      String      @default("react") // react | dag
  plan          String      @default("") // JSON plan
  result        String      @default("")
  error         String?
  tokensIn      Int         @default(0)
  tokensOut     Int         @default(0)
  costUsd       Float       @default(0)
  steps         TaskStep[]
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
}

model TaskStep {
  id          String    @id @default(cuid())
  taskId      String
  task        AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  idx         Int
  kind        String // thought | tool_call | tool_result | observation | final
  tool        String?
  status      String    @default("pending") // pending | running | ok | error | skipped
  parallel    Boolean   @default(false)
  input       String    @default("")
  output      String    @default("")
  durationMs  Int?
  startedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([taskId])
}

model UsageEvent {
  id         String   @id @default(cuid())
  sandboxId  String
  sandbox    Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  kind       String // compute | hibernate | storage | snapshot | fork | agent-llm
  seconds    Int      @default(0)
  vcpu       Int      @default(0)
  costUsd    Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([sandboxId, createdAt])
  @@index([createdAt])
}

model Budget {
  id               String   @id @default(cuid())
  monthlyLimitUsd  Float    @default(20)
  alertThreshold   Float    @default(0.8)
  spentUsd         Float    @default(0)
  alertsSent       Int      @default(0)
  hardStop         Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   @default("console")
  action    String
  resource  String
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EventLog {
  id        String   @id @default(cuid())
  level     String   @default("info") // info | warn | error | success
  source    String   @default("fleet") // fleet | sandbox | agent | billing | api
  message   String
  refId     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Flint · RLM Sessions (prime-agent parity)
// Append-only transcripts, fork lineage, compaction state,
// recursive subagent forests, A2A messaging.
// ─────────────────────────────────────────────────────────────

model AgentSession {
  id            String    @id @default(cuid())
  name          String
  role          String    @default("main") // main | subagent | decision | factory-node
  depth         Int       @default(0) // 0 = root session
  parentId      String? // parent session (subagent lineage)
  forkOfId      String? // fork lineage
  status        String    @default("idle") // idle | thinking | running | idle-evicted | archived | error
  provider      String    @default("zai")
  model         String    @default("glm-4.7")
  thinkingLevel String    @default("off") // off | low | medium | high
  sandboxId     String?
  sandbox       Sandbox?  @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  goalId        String? // active goal driving continuation
  kernelOk      Boolean   @default(true) // kernel process alive
  compactedAt   DateTime?
  compactCount  Int       @default(0)
  tokensIn      Int       @default(0)
  tokensOut     Int       @default(0)
  costUsd       Float     @default(0)
  turnCount     Int       @default(0)
  lastMessage   String    @default("")
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages  SessionMessage[]
  children  AgentSession[]  @relation("SubagentTree")
  parent    AgentSession?   @relation("SubagentTree", fields: [parentId], references: [id], onDelete: SetNull)
  inbox     AgentMessage[]  @relation("MsgTo")
  outbox    AgentMessage[]  @relation("MsgFrom")
  goals     AgentGoal[]
  heartbeats Heartbeat[]

  @@index([status])
  @@index([parentId])
  @@index([lastActiveAt])
}

model SessionMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  idx       Int
  role      String // system | user | assistant | tool | event | summary
  kind      String   @default("chat") // chat | code | stdout | a2a | goal | heartbeat | compact | gate | error | spawn
  content   String
  meta      String   @default("{}")
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([sessionId, idx])
}

model AgentMessage {
  id          String   @id @default(cuid())
  fromId      String
  from        AgentSession @relation("MsgFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String // "*" = broadcast to nuclear family
  to          AgentSession @relation("MsgTo", fields: [toId], references: [id], onDelete: Cascade)
  body        String
  mode        String   @default("follow-up") // steer | follow-up
  status      String   @default("pending") // pending | delivered | read
  createdAt   DateTime @default(now())

  @@index([toId, status])
  @@index([fromId])
}

model AgentGoal {
  id           String   @id @default(cuid())
  sessionId    String
  session      AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  objective    String
  status       String   @default("active") // active | complete | exhausted | cancelled
  tokenBudget  Int      @default(80000)
  tokensUsed   Int      @default(0)
  turnsUsed    Int      @default(0)
  result       String   @default("")
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([status])
}

model Heartbeat {
  id        String   @id @default(cuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  cron      String // 5-field cron expression
  prompt    String // prompt delivered on each fire
  mode      String   @default("follow-up") // steer | follow-up
  enabled   Boolean  @default(true)
  lastFiredAt DateTime?
  nextFireAt DateTime?
  fireCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([enabled, nextFireAt])
}

// Continual Harness — self-improvement substrate
model HarnessItem {
  id         String   @id @default(cuid())
  kind       String // memory | prompt_note | skill | subagent_spec
  name       String
  content    String
  scope      String   @default("global") // global | session
  sessionId  String? // when scope=session
  tags       String   @default("")
  useCount   Int      @default(0)
  version    Int      @default(1)
  enabled    Boolean  @default(true)
  refinements Refinement[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kind, scope])
  @@unique([kind, name, scope])
}

model Refinement {
  id         String   @id @default(cuid())
  itemId     String
  item       HarnessItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reason     String
  before     String
  after      String
  status     String   @default("planned") // planned | applied | rolled-back
  plannerModel String @default("glm-4.7")
  createdAt  DateTime @default(now())
  appliedAt  DateTime?

  @@index([itemId])
}

model McpServer {
  id          String   @id @default(cuid())
  name        String   @unique
  transport   String   @default("http") // http | stdio
  url         String   @default("")
  command     String   @default("") // stdio only
  args        String   @default("[]")
  headers     String   @default("{}")
  bearerTokenEnvVar String @default("")
  enabled     Boolean  @default(true)
  enabledTools String   @default("[]") // JSON array; empty = all
  disabledTools String @default("[]")
  toolCount   Int      @default(0)
  lastListAt  DateTime?
  createdAt   DateTime @default(now())
}

model FactoryMachine {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  spec        String // JSON machine-spec: nodes, edges, foreach, guards, budgets
  isOfficial  Boolean  @default(true)
  runs        FactoryRun[]
  createdAt   DateTime @default(now())
}

model FactoryRun {
  id          String   @id @default(cuid())
  machineId   String
  machine     FactoryMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sessionId   String? // root session that launched it
  status      String   @default("queued") // queued | running | done | failed | stopped
  input       String   @default("{}")
  nodeStates  String   @default("{}") // JSON per-node status/output
  budgetMs    Int      @default(600000)
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Durable Mesh — Durable-Objects-style actor state + stateless
// sandbox mesh (2026 research: Cloudflare DOs, E2B, Daytona,
// InstaBox, microsandbox, GitHub Actions, Jupyter endpoints).
// ─────────────────────────────────────────────────────────────

// A durable actor (Cloudflare Durable Object analogue). One row per
// named object: agent:<sessionId> | space:<name> | custom.
model DurableObject {
  id           String   @id @default(cuid())
  name         String   @unique // deterministic actor name
  className    String   @default("AgentActor") // actor class
  status       String   @default("idle") // idle | active | hibernated
  state        String   @default("{}") // last-synced KV state (mirror/cache)
  stateVersion Int      @default(0)
  opsCount     Int      @default(0)
  storageBytes Int      @default(0)
  eventCount   Int      @default(0)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([className])
  @@index([lastActiveAt])
}

// Append-only, event-sourced log per durable object (source of
// truth lives in the actor's SQLite storage; this is the
// queryable mirror for cross-node reads).
model DurableEvent {
  id        String   @id @default(cuid())
  objectName String
  topic     String   @default("log")
  kind      String   @default("event")
  payload   String   @default("{}")
  seq       Int      @default(0)
  createdAt DateTime @default(now())

  @@index([objectName, seq])
  @@index([topic, createdAt])
}

// Versioned state/kernel/filesystem snapshots — the heart of the
// stateless-sandbox protocol: any node, any provider, any time.
model DurableSnapshot {
  id          String   @id @default(cuid())
  objectName  String
  ref         String   @unique // snap_<hash>
  kind        String   @default("state") // state | kernel | fs | mesh
  version     Int      @default(1)
  sizeBytes   Int      @default(0)
  blobPath    String   @default("") // on-disk blob (tar/json/pickle)
  manifest    String   @default("{}")
  forkCount   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([objectName, kind])
  @@index([ref])
}

// A sandbox registered in the mesh (any provider). External
// machines are cattle: state lives in DurableSnapshots, never in
// the sandbox itself.
model MeshSandbox {
  id            String    @id @default(cuid())
  provider      String // local | docker | instabox | e2b | daytona | github-actions | jupyter
  externalId    String? // provider-side machine id
  handle        String? // SDK/connection handle (JSON)
  spec          String    @default("{}") // image, size, region, workspace
  status        String    @default("cold") // cold | warm | busy | paused | error | recycled
  region        String    @default("")
  costPerHourUsd Float    @default(0)
  usageSeconds  Float     @default(0)
  tasksRun      Int       @default(0)
  failures      Int       @default(0)
  lastError     String?
  lastHeartbeat DateTime  @default(now())
  createdAt     DateTime  @default(now())
  recycledAt    DateTime?
  tasks         MeshTask[]

  @@index([provider, status])
  @@index([status])
}

// One stateless execution through the mesh: snapshot-in → exec →
// snapshot-out. Survives provider death via cross-provider
// failover (attempts log).
model MeshTask {
  id           String   @id @default(cuid())
  sandboxId    String?
  sandbox      MeshSandbox? @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  provider     String
  kind         String   @default("exec") // exec | script | notebook
  status       String   @default("queued") // queued | running | done | failed | cancelled
  spec         String   @default("{}") // command, files, env, timeoutMs, language
  snapshotIn   String?  // DurableSnapshot.ref restored before exec
  snapshotOut  String?  // DurableSnapshot.ref captured after exec
  result       String   @default("{}") // exitCode, stdout, stderr, artifacts
  attempts     String   @default("[]") // JSON [{provider, ok, error, durationMs}]
  durationMs   Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([status])
  @@index([provider])
}

// Provider health / circuit-breaker state (mirrors in-memory
// registry; DB copy survives restarts and drives observability).
model ProviderHealth {
  provider            String   @id
  configured          Boolean  @default(false)
  status              String   @default("unknown") // healthy | degraded | cooldown | unconfigured
  capabilities        String   @default("[]")
  costTier            String   @default("free")
  inflight            Int      @default(0)
  totalTasks          Int      @default(0)
  failedTasks         Int      @default(0)
  consecutiveFailures Int      @default(0)
  cooldownUntil       DateTime?
  lastError           String?
  lastSuccessAt       DateTime?
  lastCheckedAt       DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
